# ── Backend ───────────────────────────────────────────
# Path to the DistilBERT V8 model directory inside the container.
# Default: /app/model (already set in Dockerfile).
# Only change this if you mount the model at a different path.
MODEL_PATH=/app/model

# ── Frontend (build-time only) ────────────────────────────
# Set to empty string for Docker (nginx proxy handles routing).
# Set to http://localhost:8000 for local development.
VITE_API_URL=
